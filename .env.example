# Copy to .env (never commit .env). All backend settings use the LUNARNAV_ prefix.
LUNARNAV_ENV=development
LUNARNAV_LOG_LEVEL=INFO
# false = human-readable console logs; true = JSON lines (use in production)
LUNARNAV_LOG_JSON=false
# Where kernels, DEM windows and cached results live (default: ./data)
# LUNARNAV_DATA_DIR=./data
# JSON list of allowed browser origins
# LUNARNAV_CORS_ORIGINS=["http://localhost:5173"]

# ---- Production / hardening (Stage 11) ----
# Concurrent computing requests (a cold scenario is ~25 s of one CPU core). Laptop default 4; use 2 on a small host.
# LUNARNAV_MAX_HEAVY_REQUESTS=2
# Seconds a computing request may wait for a slot before receiving 503 SERVER_BUSY
# LUNARNAV_HEAVY_QUEUE_SECONDS=90
# Largest accepted request body in bytes
# LUNARNAV_MAX_BODY_BYTES=262144
# Built web UI served by `uvicorn lunarnav_api.serve:app` (default: web/dist)
# LUNARNAV_WEB_DIST=./web/dist
