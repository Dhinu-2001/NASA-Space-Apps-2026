  "info": {
    "description": "Stage 2: sites and DEM lookup. Sun/Earth, horizon and visibility endpoints are declared in docs/API_CONTRACT.md and are NOT implemented yet.",
    "title": "Lunar Landing Site Navigator API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/dem/elevation": {
      "get": {
        "operationId": "dem_elevation_dem_elevation_get",
        "parameters": [
          {
            "description": "Planetocentric latitude, degrees (south negative)",
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "description": "Planetocentric latitude, degrees (south negative)",
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "description": "East-positive longitude, degrees, [-180, 360]",
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "description": "East-positive longitude, degrees, [-180, 360]",
              "title": "Lon",
              "type": "number"
            }
          },
          {
            "description": "Force a specific DEM window",
            "in": "query",
            "name": "window_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Force a specific DEM window",
              "title": "Window Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ElevationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Dem Elevation",
        "tags": [
          "dem"
        ]
      }
    },
