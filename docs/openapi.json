    "/horizon/profile": {
      "get": {
        "operationId": "horizon_profile_horizon_profile_get",
        "parameters": [
          {
            "description": "Catalogue site id (see GET /sites)",
            "in": "query",
            "name": "site_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Catalogue site id (see GET /sites)",
              "title": "Site Id"
            }
          },
          {
            "description": "Planetocentric latitude, degrees (south negative)",
            "in": "query",
            "name": "lat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Planetocentric latitude, degrees (south negative)",
              "title": "Lat"
            }
          },
          {
            "description": "East-positive longitude, degrees",
            "in": "query",
            "name": "lon",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "East-positive longitude, degrees",
              "title": "Lon"
            }
          },
          {
            "description": "Observer height above the DEM surface, metres. If omitted the default assumption 2.0 m (decision C9) is used and reported as such.",
            "in": "query",
            "name": "observer_height_m",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Observer height above the DEM surface, metres. If omitted the default assumption 2.0 m (decision C9) is used and reported as such.",
              "title": "Observer Height M"
            }
          },
          {
            "description": "Azimuth step; must divide 360",
            "in": "query",
            "name": "az_step_deg",
            "required": false,
            "schema": {
              "default": 0.25,
              "description": "Azimuth step; must divide 360",
              "title": "Az Step Deg",
              "type": "number"
            }
          },
          {
            "description": "Radial sampling step, m (default: finest pixel size)",
            "in": "query",
            "name": "step_m",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Radial sampling step, m (default: finest pixel size)",
              "title": "Step M"
            }
          },
          {
            "description": "Cap on ray length (default: DEM coverage)",
            "in": "query",
            "name": "max_range_km",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cap on ray length (default: DEM coverage)",
              "title": "Max Range Km"
            }
          },
          {
            "description": "Serve/store the cached profile",
            "in": "query",
            "name": "use_cache",
            "required": false,
            "schema": {
              "default": true,
              "description": "Serve/store the cached profile",
              "title": "Use Cache",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HorizonResponse"
