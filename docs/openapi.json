            "in": "query",
            "name": "window_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Force a specific DEM window",
              "title": "Window Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
